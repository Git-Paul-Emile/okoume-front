# URL de l'API OKOZA (dossier api/), sans /api/v1. Obligatoire : toutes les données viennent de l'API.
VITE_BACKEND_URL=http://localhost:3000
# Same value as SEED_DEMO_PASSWORD in api/.env, for local development only.
OKOZA_DEMO_PASSWORD=
# Mettre true uniquement pour un aperçu Vercel relié à une API de test/staging.
VITE_SIMULATE_CONFIRMATIONS=

# Supervision des erreurs (Sentry, projet navigateur). Vide : aucune remontée
VITE_SENTRY_DSN=
