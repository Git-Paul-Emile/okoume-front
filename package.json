{
  "name": "boutique-gabon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c green,yellow,magenta \"npm --prefix ../api run dev\" \"npm --prefix ../api run dev:worker\" \"npm:web\"",
    "web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:up": "node ../api/node_modules/tsx/dist/cli.mjs e2e/support/up.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-charts": "^9.16.0",
    "@sentry/react": "^11.14.0",
    "@tanstack/react-query": "^5.105.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
